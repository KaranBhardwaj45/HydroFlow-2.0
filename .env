SECRET_KEY=hydroflow-production-key-2026-real-hardware
PORT=3000
HOST=0.0.0.0
FLASK_DEBUG=false

DATABASE_PATH=instance/hydroflow.db
DATABASE_URL=sqlite:///./instance/hydroflow.db

# IoT Device Settings
DEVICE_ID=hydroponic-esp32-01
DEMO_MODE=false
SENSOR_STALE_SECONDS=60

# Verified ThingSpeak Cloud Telemetry Configuration
# Channel 3143605 - Plant Monitoring System (DHT11, pH, Soil Moisture, MQ135)
THINGSPEAK_CHANNEL_ID=3143605
THINGSPEAK_API_KEY=6B21IB9FC1R7WDZ2
THINGSPEAK_READ_API_KEY=6B21IB9FC1R7WDZ2

# Optional EMQX MQTT Broker Configuration (Future-Ready)
EMQX_HOST=
EMQX_PORT=8883
EMQX_USERNAME=
EMQX_PASSWORD=
EMQX_CLIENT_ID=hydroflow-backend
EMQX_USE_TLS=true
EMQX_CA_CERT_PATH=
EMQX_KEEPALIVE=60
