# ==============================================================================
# HYDROFLOW - Environment Configuration
# Smart IoT Hydroponics Management System
# ==============================================================================

# Flask Server Configuration
SECRET_KEY=hydroflow-super-secure-production-key-change-me
PORT=3000
HOST=0.0.0.0
FLASK_DEBUG=false

# SQLite Database
DATABASE_PATH=instance/hydroflow.db

# IoT Device Settings
DEVICE_ID=ESP32-001
DEMO_MODE=true
SENSOR_STALE_SECONDS=30

# EMQX MQTT Broker Configuration
# For production EMQX Cloud: e.g. xxxxx.emqx.cloud
EMQX_HOST=
EMQX_PORT=8883
EMQX_USERNAME=
EMQX_PASSWORD=
EMQX_CLIENT_ID=hydroflow-backend
EMQX_USE_TLS=true
EMQX_CA_CERT_PATH=
EMQX_KEEPALIVE=60

# ThingSpeak Cloud Telemetry Configuration
THINGSPEAK_API_KEY=
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_READ_API_KEY=
